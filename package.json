{
  "name": "blog-19182",
  "description": "Mateo's blog — a minimal static site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "CC0-1.0",
  "scripts": {
    "test:newsletter": "node --test tests/newsletter.test.mjs",
    "test:updates": "node --test tests/updates.test.mjs",
    "test:links": "node --test tests/links.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "newsletter:preview": "node tools/send-newsletter.mjs",
    "build": "node build.mjs",
    "favicons": "node tools/fetch-favicons.mjs",
    "sync:feijoo": "node tools/sync-feijoo-preview.mjs",
    "preview:feijoo": "npm run sync:feijoo && npm run serve",
    "serve": "node build.mjs --serve",
    "dev": "node build.mjs --serve --watch",
    "soundtrack:peaks": "node tools/soundtrack-peaks.mjs",
    "screenshots": "node tools/project-screenshots.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@resvg/resvg-js": "^2.6.2",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.5.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-texmath": "^1.0.0",
    "pagefind": "^1.5.2",
    "satori": "^0.19.1",
    "shiki": "^1.26.2"
  }
}
